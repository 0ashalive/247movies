{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/data.json",
      "dest": "api/data.py"
    },
    {
      "src": "/latest.m3u",
      "dest": "api/m3u.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/data.py"
    }
  ]
}
